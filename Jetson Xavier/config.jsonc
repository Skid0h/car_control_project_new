{
  "network": {
    "udp_ip"  : "0.0.0.0",
    "udp_port": 5005
  },

  "car": {
    "baud_rate"        : 9600,
    "neutral_speed"    : 1500,   // ШИМ для нейтрального положения мотора
    "forward_speed"    : 1570,
    "back_speed"       : 1430,
    "center_steering"  : 135,    // Центральное положене сервопривода (0-270 градусов)
    "steering_range"   : 90,     // Отклонение руля от центра (45 - 225 градусов)
    "command_interval" : 0.1,    // Минимальный интервал между отправкой повторяющихся команд (секунды)
    "watchdog_timeout" : 0.4     // Таймаут сторожевого таймаута: если команд нет дольше этого времени - остановка (секунды)
  },

  "autopilot": {
    "max_depth"                   : 3.0,    // Максимальная дальность обнаружения конусов (метры)
    "min_depth"                   : 0.1,    // Минимальная дальность (защита от ложных срабатываний вплотную)
    "track_width"                 : 1.4,    // Ширина трассы между синими и жёлтыми конусами (метры)
    "pair_z_tolerance"            : 1.0,    // Максимальная разница по глубине для пары конусов (метры)
    "pair_x_tolerance_multiplier" : 1.5,    // Множитель ширины трассы для допуска по X при поиске пар
    "area_depth_constant"         : 150.0   // Коэффициент перевода площади в метры. Глубина = area_depth_constant / sqrt(площадь).
  },

  "vision": {
    "yolo_model_path"        : "/mnt/ArdorSSD/car_control_project_new/Datasets/cone_detector_v3.engine",
    "confidence_threshold"   : 0.5,                     // Порог уверенности детекции
    "iou_threshold"          : 0.5,                     // Порог IoU для NMS (подавление пересекающихся рамок)
    "output_folder"          : "zed_recordings",        // Папка для сохранения видеозаписей
    "camera_offset_x"        : -0.06,                   // Смещение камеры по оси X (влево/вправо) относительно центра машины (метры)
    "camera_offset_z"        : 0.3,                     // Смещение камеры по оси Z (вперёд/назад) относительно центра машины (метры)
    "zed_resolution"         : "HD720",
    "zed_fps"                : 15,
    "coordinate_units"       : "METER",
    "cone_base_v"            : 0.65,                    // Вертикальная координата для отрисовки точек траектории (доля от высоты кадра)
    "target_cross_size"      : 25,                      // Размер прицельного креста на целевой точке (пиксели)
    "target_cross_thickness" : 3                        // Толщина линий прицельного креста (пиксели)
  },

  "detection": {
    "blue_cones"  : ["blue"],     // Какие имена конусов считаются СИНИМИ 
    "yellow_cones": ["yellow"],   // Какие имена конусов считаются ЖЁЛТЫМИ 
    "orange_cones": ["orange"]    // Какие имена конусов считаются ОРАНЖЕВЫМИ 
  },

  "display": {
    "draw_detections"        : false,    // Включить отрисовку рамок конусов
    "draw_trajectory"        : false,    // Включить отрисовку траектории
    "draw_target"            : true,     // Включить отрисовку цели
    "draw_fps"               : true,     // Включить отрисовку FPS и текущего режима машинки
    "draw_rec"               : true,     // Включить индикатор записи
    "draw_cone_quad"         : true,     // Включить отрисовку 4 линий четырёхугольника из 2 пар конусов.
    "fps_text_scale"         : 0.7,      // Масштаб шрифта для отображения FPS и режима
    "fps_text_thickness"     : 2,        // Толщина шрифта FPS и режима
    "fps_text_color"         : [0, 255, 0],  // Цвет текста FPS и режима в BGR
    "rec_text_scale"         : 0.7,      // Масштаб шрифта индикатора записи "REC"
    "rec_text_thickness"     : 2,        // Толщина шрифта индикатора записи
    "rec_text_color"         : [0, 0, 255]   // Цвет индикатора записи в BGR
  },

  "video": {
    "temp_codec"         : "MJPG",       // Кодек для временного видеофайла (MJPG - быстрая запись)
    "output_codec"       : "libx264",    // Кодек для финального видео (libx264 - сжатие в H.264)
    "output_preset"      : "fast",       // Пресет кодирования ffmpeg (fast - баланс скорости и качества)
    "output_crf"         : "23",         // Качество сжатия CRF для H.264 (0-51, 23 - стандартное)
    "output_pix_fmt"     : "yuv420p",    // Формат пикселей для совместимости с проигрывателями
    "output_extension"   : "mp4",        // Расширение финального видеофайла
    "temp_extension"     : "avi",        // Расширение временного видеофайла
    "output_prefix"      : "zed_recording",  // Префикс имени файла видеозаписи (добавляется временная метка)
    "fps_update_interval": 0.5           // Интервал обновления счётчика FPS на экране (секунды)
  },

  "timing": {
    "vision_thread_join_timeout": 3.0,   // Таймаут ожидания завершения потока компьютерного зрения (секунды)
    "message_clear_timeout"     : 3.0,   // Время отображения сообщения статуса перед очисткой (секунды)
    "socket_timeout"            : 0.2    // Таймаут UDP-сокета для возможности проверки сторожевого таймаута (секунды)
  }
}