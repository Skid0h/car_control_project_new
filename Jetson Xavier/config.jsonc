{
  "network": {
    "udp_ip"  : "0.0.0.0",
    "udp_port": 5005
  },

  "car": {
    "baud_rate"        : 9600,
    "neutral_speed"    : 1500,   // ШИМ для нейтрального положения мотора
    "forward_speed"    : 1570,
    "back_speed"       : 1420,
    "center_steering"  : 100,    // Центральное положене сервопривода (0-270 градусов)
    "command_interval" : 0.02,    // Минимальный интервал между отправкой повторяющихся команд (секунды)
    "watchdog_timeout" : 0.4,    // Таймаут сторожевого таймера: если команд нет дольше этого времени - остановка (секунды)
    "steering_range"   : 50      // Отклонение руля от центра (45 - 225 градусов)
  },

  "pid": {                  // Настройки ПИД-регулятора
    "kp_gain": 1.0,         // ПРОПОРЦИОНАЛЬНЫЙ КОЭФФИЦИЕНТ. Определяет, насколько резко руль поворачивает
    //  в ответ на отклонение от траектории. Если машина "вялая" и не вписывается в повороты — увеличьте (1.2-1.5).
    //  Если рыскает из стороны в сторону и перекручивает руль — уменьшите (0.6-0.8). 
    // Это главный параметр, влияет на мгновенную реакцию. Слишком большой = машина виляет и теряет стабильность на прямой. 
    // Слишком маленький = не успевает за поворотами и вылетает с трассы.

    "ki_gain": 0.1,         // ИНТЕГРАЛЬНЫЙ КОЭФФИЦИЕНТ. Накапливает ошибку со временем.
    //  Убирает постоянное смещение (например, если машину всё время тянет влево из-за кривого руля или наклона трассы).
    //  Если машина постепенно съезжает к одному краю на прямой — увеличьте (0.15-0.2).
    //  Если чувствуете, что руль "залипает" и поздно возвращается в центр после поворота — уменьшите (0.05).
    //  Большой Ki делает машину инертной и склонной к перерегулированию (проскакивает центр после поворота).
    //  Маленький Ki = не исправляет систематическую ошибку, машина едет "косо".

    "kd_gain": 0.25,        // ДИФФЕРЕНЦИАЛЬНЫЙ КОЭФФИЦИЕНТ. Демпфер, сглаживает резкие движения руля.
    //  Работает как амортизатор: чем больше Kd, тем плавнее машина входит в поворот и выходит из него, без рывков.
    //  Если при резком повороте руль дёргается и машина вихляет — увеличьте (0.3-0.5).
    //  Если машина стала "ватной", с задержкой реагирует на изменение траектории и не успевает за быстрыми поворотами — уменьшите (0.1-0.15).
    //  Высокий Kd = плавно, но медленно. Низкий Kd = быстро, но с рывками.

    "max_integral": 1.5,    // ОГРАНИЧИТЕЛЬ ИНТЕГРАЛЬНОЙ ОШИБКИ (анти-windup).
    //  Не даёт интегральной части "уйти в разнос" и потом долго возвращаться.
    //  Если после серии крутых поворотов машина долго едет с вывернутым рулём по прямой — уменьшите (0.8-1.0),
    //  это значит Ki накопил слишком много.
    //  Если машина не может удержать постоянный угол на длинной дуге (руль "сползает") — увеличьте (2.0-2.5).
    //  Типичные значения: 1.0-2.0. Слишком маленький = не исправляет систематическую ошибку,
    //  слишком большой = долгий "откат" руля после поворота.

    "ema_alpha": 0.4,       // КОЭФФИЦИЕНТ СГЛАЖИВАНИЯ ОШИБКИ (экспоненциальное скользящее среднее).
    //  Фильтрует "шум" от детекции конусов. При 0.4 — каждое новое измерение весит 40%, старая траектория 60%.
    //  Если траектория дёргается из-за ложных/пропадающих детекций конусов — уменьшите (0.15-0.25), машина станет плавнее,
    //  но "задумчивее". Если нужно быстро реагировать на реальные изменения трассы — увеличьте (0.6-0.8),
    //  машина станет резвее, но может дёргаться от мусорных детекций. 0.0 = полное усреднение (руль стоит на месте),
    //  1.0 = без фильтрации (каждое детектирование мгновенно влияет на руль).
    
    "error_decay_rate": 0.85,   // СКОРОСТЬ ЗАТУХАНИЯ ОШИБКИ ПРИ ПОТЕРЕ ЦЕЛИ.
    //  Когда камера теряет конусы (поворот, засветка, яма), руль не бросает в ноль мгновенно,
    //  а плавно возвращается в центр. 0.85 значит: каждую итерацию ошибка умножается на 0.85,
    //  плавно возвращая руль в центр за ~20 кадров.
    //  Если при пропадании конусов руль возвращается слишком медленно и машина "помнит" последний поворот — уменьшите (0.7-0.8).
    //  Если руль бросает резко и машина вылетает с трассы при кратковременной потере конусов — увеличьте (0.9-0.95).
    //  1.0 = не затухает вообще (опасно!), 0.0 = мгновенный сброс в ноль.

    "max_steering_output": 1.0, // МАКСИМАЛЬНЫЙ ВЫХОД ПИД НА РУЛЬ. Ограничивает максимальный угол поворота колёс.
    //  1.0 = полный диапазон (до упора влево-вправо).
    //  Если на высокой скорости машина переворачивается или колёса упираются в ограничители с хрустом — уменьшите (0.6-0.8),
    //  это ограничит максимальный угол. Если не хватает угла поворота для крутых поворотов — оставьте 1.0.
    //  Полезно менять на ходу: на разгоне 0.5, на крейсерской скорости 0.8, в крутом повороте 1.0.

    "min_dt": 0.001             // МИНИМАЛЬНЫЙ ШАГ ВРЕМЕНИ ДЛЯ РАСЧЁТА ПРОИЗВОДНОЙ. Защита от деления на ноль,
    //  если два кадра пришли почти одновременно. Не трогайте без крайней необходимости.
    //  Увеличение (0.01) сделает Kd менее чувствительным к быстрым изменениям.
    //  Уменьшение (0.0001) может вызвать числовую нестабильность при высоком FPS.
  },

  "autopilot": {
    "max_depth"                  : 3.0,    // Максимальная дальность обнаружения конусов (метры)
    "min_depth"                  : 0.1,    // Минимальная дальность (защита от ложных срабатываний вплотную)
    "track_width"                : 1.4,    // Ширина трассы между синими и жёлтыми конусами (метры)
    "lookahead_distance"         : 0.5,    // Дистанция упреждения для Pure Pursuit
    "pair_z_tolerance"           : 1.0,    // Максимальная разница по глубине для пары конусов (метры)
    "pair_x_tolerance_multiplier": 1.5,    // Множитель ширины трассы для допуска по X при поиске пар
    "virtual_point_offset"       : 0.7,    // Смещение виртуальных точек от одиночных конусов
    "stop_cone_z_threshold"      : 0.4,    // Порог расстояния до стоп-конуса для остановки (метры)
    "area_depth_constant"        : 100.0   // Коэффициент перевода площади в метры. Глубина = area_depth_constant / sqrt(площадь).
  },

  "vision": {
    "yolo_model_path"            : "/mnt/ArdorSSD/car_control_project_new/Datasets/cone_detector_v3.engine",
    "confidence_threshold"       : 0.5,                     // Порог уверенности детекции
    "iou_threshold"              : 0.5,                     // Порог IoU для NMS (подавление пересекающихся рамок)
    "target_fps"                 : 15.0,
    "output_folder"              : "zed_recordings",        // Папка для сохранения видеозаписей
    "camera_offset_x"            : -0.06,                   // Смещение камеры по оси X относительно центра машины (метры)
    "camera_offset_z"            : 0.15,                    // Расстояние от камеры до передней оси машины (метры). Конус реально ближе на это значение
    "zed_resolution"             : "HD720",
    "zed_fps"                    : 15,
    "depth_mode"                 : "PERFORMANCE",           // Режим глубины ZED: PERFORMANCE, QUALITY, ULTRA
    "coordinate_units"           : "METER",
    "cone_base_v"                : 0.65,                    // Вертикальная координата для отрисовки точек траектории (доля от высоты кадра, 0.65 = 65% сверху)
    "point_of_view_offset_y"     : 0.8,                     // Смещение точки прицела конуса вниз от верха рамки (0.8 = 80% высоты bbox)
    "target_cross_size"          : 25,                      // Размер прицельного креста на целевой точке (пиксели)
    "target_cross_thickness"     : 3                        // Толщина линий прицельного креста (пиксели)
  },

  "detection": {
    "cone_colors": {
      "yellow": [0, 255, 255],                     // Жёлтый конус — левая граница трассы
      "orange": [0, 165, 255],                     // Оранжевый стоп-конус — финиш
      "blue": [255, 0, 0]                          // Синий конус — правая граница трассы
    },
    "class_names": {
      "0": "yellow",                               // Маппинг: ID модели → имя конуса (строчные буквы)
      "1": "orange",                               // YOLO выдаёт номер класса, мы превращаем в имя
      "2": "blue"
    },
    "blue_cones": ["blue"],                        // Какие имена конусов считаются СИНИМИ 
    "yellow_cones": ["yellow"],                    // Какие имена конусов считаются ЖЁЛТЫМИ 
    "orange_cones": ["orange"],                    // Какие имена конусов считаются ОРАНЖЕВЫМИ 
    "circle_marker_radius": 4,                     // Радиус маркера центра конуса (пиксели)
    "circle_marker_color": [255, 255, 255],        // Цвет маркера центра конуса в BGR 
    "text_scale": 0.5,                             // Масштаб шрифта для подписей классов и уверенности
    "text_thickness": 2,                           // Толщина шрифта подписей
    "z_text_scale": 0.4,                           // Масштаб шрифта для отображения глубины Z
    "z_text_thickness": 1,                         // Толщина шрифта глубины Z
    "z_text_color": [255, 255, 255]                // Цвет текста глубины Z в BGR (белый)
  },

  "display": {
    "draw_detections"        : true,               // Включить отрисовку рамок конусов.
    "draw_trajectory"        : true,               // Включить отрисовку траектории. 
    "draw_target"            : true,               // Включить отрисовку цели. 
    "draw_fps"               : true,               // Включить отрисовку FPS и текущего режима машинки. 
    "draw_target_z"          : true,               // Включить отображение расстояния до цели. 
    "draw_rec"               : true,               // Включить индикатор записи.
    "fps_text_scale"         : 0.7,                // Масштаб шрифта для отображения FPS и режима
    "fps_text_thickness"     : 2,                  // Толщина шрифта FPS и режима
    "fps_text_color"         : [0, 255, 0],        // Цвет текста FPS и режима в BGR
    "target_z_text_scale"    : 0.6,                // Масштаб шрифта для отображения расстояния до целевой точки
    "target_z_text_thickness": 2,                  // Толщина шрифта расстояния до цели
    "target_z_text_color"    : [0, 255, 255],      // Цвет текста расстояния до цели в BGR
    "rec_text_scale"         : 0.7,                // Масштаб шрифта индикатора записи "REC"
    "rec_text_thickness"     : 2,                  // Толщина шрифта индикатора записи
    "rec_text_color"         : [0, 0, 255],        // Цвет индикатора записи в BGR
    "trajectory_thickness"   : 2,                  // Толщина линии траектории (пиксели)
    "trajectory_color"       : [0, 255, 0],        // Цвет линии траектории в BGR
    "waypoint_radius"        : 6,                  // Радиус точек траектории (пиксели)
    "waypoint_color_pair"    : [0, 255, 0],        // Цвет точек от реальных пар конусов в BGR
    "waypoint_color_virtual" : [255, 200, 0],      // Цвет виртуальных точек (от одиночных конусов) в BGR
    "waypoint_color_stop"    : [0, 0, 255],        // Цвет точки стоп-конуса в BGR
    "pair_line_thickness"    : 1,                  // Толщина линии, соединяющей пару конусов (пиксели)
    "pair_line_color"        : [0, 255, 255]       // Цвет линии пары конусов в BGR
  },

  "video": { 
    "temp_codec"         : "MJPG",            // Кодек для временного видеофайла (MJPG - быстрая запись)
    "output_codec"       : "libx264",         // Кодек для финального видео (libx264 - сжатие в H.264)
    "output_preset"      : "fast",            // Пресет кодирования ffmpeg (fast - баланс скорости и качества)
    "output_crf"         : "23",              // Качество сжатия CRF для H.264 (0-51, 23 - стандартное, меньше = лучше)
    "output_pix_fmt"     : "yuv420p",         // Формат пикселей для совместимости с проигрывателями
    "output_extension"   : "mp4",             // Расширение финального видеофайла
    "temp_extension"     : "avi",             // Расширение временного видеофайла
    "output_prefix"      : "zed_recording",   // Префикс имени файла видеозаписи (добавляется временная метка)
    "fps_update_interval": 0.5                // Интервал обновления счётчика FPS на экране (секунды)
  },

  "timing": {
    "vision_thread_join_timeout": 3.0,   // Таймаут ожидания завершения потока компьютерного зрения (секунды)
    "message_clear_timeout"     : 3.0,   // Время отображения сообщения статуса перед очисткой (секунды)
    "socket_timeout"            : 0.2,   // Таймаут UDP-сокета для возможности проверки сторожевого таймера (секунды)
    "arduino_init_delay"        : 2.0,   // Задержка после открытия порта Arduino для инициализации (секунды)
    "arduino_post_stop_delay"   : 0.5,   // Задержка после отправки команды STOP при инициализации (секунды)
    "arduino_close_delay"       : 0.1    // Задержка перед закрытием порта Arduino (секунды)
  }
}
