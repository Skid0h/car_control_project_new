{
  "network": {
    "udp_ip"  : "0.0.0.0",
    "udp_port": 5005
  },

  "web": {
    "host"        : "0.0.0.0",  // "0.0.0.0" - трансляцию видит вся сеть (без пароля). "127.0.0.1" - только сам Jetson.
    "port"        : 5000,
    "publish_fps" : 8.0,        // Сколько кадров в секунду кодируется и уходит в браузер. На частоту управления НЕ влияет.
    "jpeg_quality": 70          // Качество JPEG для трансляции (1-100). Меньше = меньше нагрузка на CPU.
  },

  "car": {
    "baud_rate"             : 9600,
    "arduino_port"          : "",     // "" = автопоиск по описанию/VID. Если на Jetson несколько USB-UART - укажите явно, например "/dev/ttyUSB0".
    "neutral_speed"         : 1500,   // ШИМ нейтрального положения мотора
    "forward_speed"         : 1570,   // ШИМ полного газа вперёд
    "back_speed"            : 1420,   // ШИМ полного газа назад
    "esc_min"               : 1400,   // ОБЯЗАНО совпадать с ESC_MIN в PC/Arduino/Main_code.ino
    "esc_max"               : 1600,   // ОБЯЗАНО совпадать с ESC_MAX в PC/Arduino/Main_code.ino
    // Прошивка отбрасывает пакет ЦЕЛИКОМ (вместе с рулём), если значение мотора вне [esc_min; esc_max],
    // и не обновляет свой failsafe-таймер - через 500 мс машина встаёт. Поэтому здесь жёсткий кламп.
    "center_steering"       : 90,     // ОБЯЗАНО совпадать со STEERING_CENTER в прошивке: именно его пишет failsafe и stopCar()
    "steering_range"        : 50,     // Отклонение руля от центра. Команды идут в диапазоне center ± range (40..140)
    "steer_min"             : 0,      // STEERING_MIN в прошивке
    "steer_max"             : 180,    // STEERING_MAX в прошивке
    "command_interval"      : 0.02,   // Минимальный интервал между повторными отправками той же команды (сек)
    "watchdog_timeout"      : 0.4,    // Если команд нет дольше этого - остановка (сек). Должно быть МЕНЬШЕ 0.5 с failsafe Arduino
    "arduino_retry_interval": 2.0     // Как часто пробовать переподключиться, если Arduino отвалилась (сек)
  },

  "control": {
    "control_rate_hz"      : 30.0,  // Частота выдачи команд в авто-режиме, Гц. Не зависит от FPS детекции:
                                    //  команды идут ровно с этой частотой, даже если YOLO считает кадр 200 мс.
                                    //  Держите 1/control_rate_hz заметно меньше watchdog_timeout Arduino (0.5 с).
    "detection_max_age"    : 0.5,   // Секунды. Результат детекции старше этого считается протухшим -> режим потери цели.
    "target_loss_max_ticks": 12     // Сколько тактов ехать с затухающим рулём без цели, потом стоп и выход из авто-режима.
                                    //  12 тактов на 30 Гц = 0.4 с. Раньше в этой ситуации команды не слались вообще
                                    //  и машина катилась до аварийного стопа Arduino.
  },

  "pid": {                  // РЕГУЛЯТОР РУЛЕНИЯ. В v1.0 работают P + EMA + упреждение; I и D зарезервированы и НЕ применяются.
    "kp_gain": 1.0,         // ПРОПОРЦИОНАЛЬНЫЙ КОЭФФИЦИЕНТ (рабочий). Общий множитель на ошибку руления.
    //  steering = clamp( EMA( atan2(x_цели, z_цели) * steer_k * kp_gain ) ).
    //  Машина "вялая", не вписывается в повороты - увеличивайте (1.2-1.5).
    //  Рыскает и перекручивает руль - уменьшайте (0.6-0.8).
    //  Это главный параметр. steer_k у точки (pair_steer_k / virtual_steer_k) задаёт относительную
    //  резвость для своего типа точек, kp_gain масштабирует всё сразу.

    "ema_alpha": 0.4,       // СГЛАЖИВАНИЕ (рабочее). Экспоненциальное скользящее среднее управляющего сигнала.
    //  0.4 = новое значение весит 40%, предыдущее сглаженное 60%. Сглаживается уже умноженная на kp_gain ошибка,
    //  поэтому смена типа цели (пара -> одиночный конус) не даёт скачка руля.
    //  Траектория дёргается от ложных/пропадающих детекций - уменьшайте (0.15-0.25), станет плавнее, но "задумчивее".
    //  Не успевает за реальными изменениями трассы - увеличивайте (0.6-0.8).
    //  1.0 = без сглаживания (каждая детекция мгновенно на руле), 0.0 = руль не двигается вообще.
    //  Такт сглаживания теперь control_rate_hz (30 Гц), а не частота кадров: при том же alpha реакция быстрее, чем была на 15 fps.

    "error_decay_rate": 0.85,   // ЗАТУХАНИЕ ПРИ ПОТЕРЕ ЦЕЛИ (рабочее). Когда конусов не видно, руль не бросается
    //  в ноль мгновенно, а умножается на это число каждый такт control_rate_hz.
    //  0.85 на 30 Гц: сигнал падает до 5% примерно за 0.6 с, до нуля - к моменту срабатывания target_loss_max_ticks.
    //  Руль возвращается слишком медленно, машина "помнит" последний поворот - уменьшайте (0.7-0.8).
    //  Бросает резко и машина вылетает при кратковременной потере конусов - увеличивайте (0.9-0.95).
    //  1.0 = не затухает вообще (опасно), 0.0 = мгновенный сброс в центр.

    "max_steering_output": 1.0, // ОГРАНИЧИТЕЛЬ РУЛЯ (рабочий). Предел |steering| после сглаживания.
    //  1.0 = полный диапазон center ± steering_range. 0.6 = не более 60% от него.
    //  На высокой скорости машина переворачивается или колёса упираются в ограничители - уменьшайте (0.6-0.8).
    //  Не хватает угла в крутых поворотах - оставляйте 1.0.

    "ki_gain": 0.1,          // ЗАРЕЗЕРВИРОВАНО, в v1.0 не используется - интегральной составляющей в коде нет.
    "kd_gain": 0.25,         // ЗАРЕЗЕРВИРОВАНО, в v1.0 не используется - дифференциальной составляющей в коде нет.
    "max_integral": 1.5,     // ЗАРЕЗЕРВИРОВАНО, анти-windup понадобится только вместе с ki_gain.
    "min_dt": 0.001          // ЗАРЕЗЕРВИРОВАНО, защита от деления на ноль для kd_gain.
    // Установившуюся боковую ошибку (машину постоянно тянет в одну сторону) в v1.0 убирает camera_offset_x
    // и калибровка center_steering, а не интегральная составляющая.
  },

  "autopilot": {
    "max_depth"                  : 4.0,    // Максимальная дальность конусов (метры). Дальние отбрасываются.
    "min_depth"                  : 0.1,    // Минимальная дальность (защита от срабатываний вплотную к объективу)
    "track_width"                : 1.5,    // Ширина трассы между синими и жёлтыми конусами (метры)
    "lookahead_distance"         : 0.5,    // ДИСТАНЦИЯ УПРЕЖДЕНИЯ (метры). Цель для руления - ПЕРВАЯ точка с z >= этого
    //  значения, а не ближайшая вообще. Если все точки ближе - берётся самая дальняя из видимых.
    //  0.5 = почти прежнее поведение (целимся в ближайшую точку), машина резко доворачивает у самых конусов и рыскает.
    //  1.0-1.5 = руль начинает поворачивать заранее, траектория плавная, рыскание заметно меньше. Основной режим для трассы.
    //  2.0-3.0 = очень плавное, "ленивое" руление: хорошо на длинных дугах и на высокой скорости,
    //            но в крутых поворотах не успевает и срезает к внутренним конусам.
    //  Увеличивайте, если машина виляет между конусами; уменьшайте, если не вписывается в повороты.
    //  Осмысленный диапазон ограничен сверху max_depth - при lookahead_distance >= max_depth цель почти всегда самая дальняя точка.
    "pair_z_tolerance"           : 1.0,    // ВЕРХНИЙ предел допуска по глубине для пары конусов (метры)
    "pair_z_tolerance_min"       : 0.25,   // НИЖНИЙ предел того же допуска (метры). Вблизи конусы почти одной глубины,
                                           //  и пропорциональный допуск стал бы меньше шума детекции.
    "pair_z_tolerance_multiplier": 0.25,   // Пропорциональная часть допуска: tol = multiplier * z, ограниченная сверху и снизу.
    //  Ошибка оценки z по площади рамки растёт вместе с z, поэтому фиксированный допуск на 4 метрах либо
    //  отсекает настоящие пары, либо пропускает соседние. Теперь на 1 м допуск 0.25 м, на 4 м - 1.0 м.
    "pair_x_tolerance_multiplier": 1.5,    // Множитель ширины трассы для допуска по X при поиске пар (1.5 * 1.5 = 2.25 м)
    "pair_steer_k"               : 2.0,    // Резвость руления по точке от ПАРЫ конусов (самый достоверный тип цели)
    "virtual_point_offset"       : 0.7,    // Смещение виртуальной точки ВНУТРЬ трассы от одиночного конуса (метры).
    //  Обычно половина track_width. Синий - правая граница, точка смещается влево; жёлтый - левая, точка смещается вправо.
    //  Если в ситуации "видно только одиночные конусы" машина уходит ОТ центра трассы - значит стороны перепутаны,
    //  поменяйте местами списки blue_cones и yellow_cones в секции detection.
    "virtual_steer_k"            : 2.5,    // Резвость руления по виртуальной точке от одиночного конуса
    "stop_cone_z_threshold"      : 0.5,    // Дистанция до оранжевого стоп-конуса, на которой машина останавливается (метры)
    "area_depth_constant"        : 129.1   // Коэффициент перевода площади рамки в метры: z = K / sqrt(площадь в пикселях ИСХОДНОГО кадра).
    //  КАЛИБРОВКА. Прежнее значение 100.0 было подобрано при ошибочном обратном масштабе по вертикали: высота рамки
    //  завышалась в 1/(1 - detect_crop_top - detect_crop_bottom) = 1/0.6 = 1.667 раза, поэтому z занижалась в sqrt(1.667) = 1.291 раза.
    //  129.1 = 100.0 * 1.291 - это та же самая дистанция, что и раньше, но уже на правильной геометрии.
    //  Если меняете detect_crop_top/detect_crop_bottom, пересчитайте: K_new = K_old * sqrt(1 / (1 - crop_top - crop_bottom)).
    //  Значение не зависит от разрешения кадра по вертикали, но ЗАВИСИТ от разрешения: при переходе HD720 -> HD1080
    //  площадь в пикселях вырастет, и K нужно уменьшить. Перекалибровка: конус наизвестной дистанции, подобрать K так,
    //  чтобы Target Z в оверлее совпал с рулеткой.
  },

  "vision": {
    "yolo_model_path"            : "/mnt/ArdorSSD/car_control_project_new/Datasets/cone_detector_v3.engine",
    "confidence_threshold"       : 0.5,     // Порог уверенности детекции
    "iou_threshold"              : 0.5,     // Порог IoU для NMS
    "target_fps"                 : 15.0,    // Потолок частоты ДЕТЕКЦИИ. Кадров захватывается zed_fps, в детектор идёт
                                            //  не больше target_fps, лишние кадры отбрасываются. Управление при этом
                                            //  работает на control_rate_hz независимо от этой величины.
    "output_folder"              : "zed_recordings",
    "camera_offset_x"            : -0.06,   // Смещение камеры по X относительно продольной оси машины (метры, + = вправо).
                                            //  Учитывается при переходе в координаты машины: x_car = x_cam + camera_offset_x.
                                            //  Знак проверить на стенде: если на прямом участке машина стабильно жмётся
                                            //  к одной стороне коридора - смените знак.
    "camera_offset_z"            : 0.10,    // Расстояние от камеры до передней оси машины (метры). Конус реально ближе на это значение.
    "zed_resolution"             : "HD720",
    "zed_fps"                    : 15,      // Частота захвата кадров камерой. Одновременно частота записи видео.
    "coordinate_units"           : "METER",
    "detect_max_width"           : 480,     // Кадр для детектора уменьшается до этих размеров (экономит время инференса).
    "detect_max_height"          : 270,     //  Пропорции сохраняются. Координаты детекций пересчитываются обратно автоматически.
    "detect_crop_top"            : 0.20,    // Доля высоты кадра, отрезаемая СВЕРХУ до детекции (небо/дальний фон).
    "detect_crop_bottom"         : 0.20,    // Доля высоты, отрезаемая СНИЗУ (капот). ВАЖНО: изменение этих двух чисел
                                            //  меняет масштаб площади рамки и требует пересчёта area_depth_constant (см. формулу там).
    "cone_base_v"                : 0.65,    // Вертикальная координата точек траектории при отрисовке (доля высоты кадра)
    "point_of_view_offset_y"     : 0.8,     // Точка прицела конуса: доля высоты bbox сверху (0.8 = основание конуса)
    "target_cross_size"          : 25,      // Размер прицельного креста на целевой точке (пиксели)
    "target_cross_thickness"     : 3        // Толщина линий прицельного креста
  },

  "detection": {
    "cone_colors": {
       "yellow": [0, 255, 255],                     // Жёлтый конус - левая граница трассы (BGR)
       "orange": [0, 165, 255],                     // Оранжевый стоп-конус - финиш (BGR)
       "blue": [255, 0, 0]                          // Синий конус - правая граница трассы (BGR)
    },
    "class_names": {
       "0": "yellow",                               // Маппинг ID класса модели -> имя конуса (строчные буквы).
       "1": "orange",                               //  При старте сверяется с model.names: если порядок в модели другой,
       "2": "blue"                                  //  детектор помечается неисправным и авто-режим не включается.
    },
    "blue_cones": ["blue"],                        // Какие имена считаются СИНИМИ (правая граница)
    "yellow_cones": ["yellow"],                    // Какие имена считаются ЖЁЛТЫМИ (левая граница)
    "orange_cones": ["orange"],                    // Какие имена считаются ОРАНЖЕВЫМИ (финиш)
    "circle_marker_radius": 4,                     // Радиус маркера точки прицела конуса (пиксели)
    "circle_marker_color": [255, 255, 255],        // Цвет маркера точки прицела (BGR)
    "text_scale": 0.5,                             // Масштаб шрифта подписей классов
    "text_thickness": 2,                           // Толщина шрифта подписей
    "z_text_scale": 0.4,                           // Масштаб шрифта глубины Z
    "z_text_thickness": 1,                         // Толщина шрифта глубины Z
    "z_text_color": [255, 255, 255]                // Цвет текста глубины Z (BGR)
  },

  "display": {
    "draw_detections"        : true,               // Рамки конусов с подписями
    "draw_trajectory"        : true,               // Полилиния траектории
    "draw_target"            : true,               // Прицельный крест на целевой точке
    "draw_fps"               : true,               // Счётчик FPS и текущий режим
    "draw_target_z"          : true,               // Расстояние до цели и Z каждого конуса
    "draw_rec"               : true,               // Индикатор записи
    "fps_text_scale"         : 0.7,
    "fps_text_thickness"     : 2,
    "fps_text_color"         : [0, 255, 0],        // BGR
    "target_z_text_scale"    : 0.6,
    "target_z_text_thickness": 2,
    "target_z_text_color"    : [0, 255, 255],      // BGR
    "rec_text_scale"         : 0.7,
    "rec_text_thickness"     : 2,
    "rec_text_color"         : [0, 0, 255],        // BGR
    "trajectory_thickness"   : 2,
    "trajectory_color"       : [0, 255, 0],        // BGR
    "waypoint_radius"        : 6,                  // Радиус кружков точек траектории
    "waypoint_color_pair"    : [0, 255, 0],        // Точки от реальных пар конусов (BGR)
    "waypoint_color_virtual" : [255, 200, 0],      // Виртуальные точки от одиночных конусов (BGR)
    "waypoint_color_stop"    : [0, 0, 255],        // Точка стоп-конуса (BGR)
    "pair_line_thickness"    : 1,
    "pair_line_color"        : [0, 255, 255]       // Линия, соединяющая пару конусов (BGR)
  },

  "video": {
    "temp_codec"         : "MJPG",            // Кодек временного файла (быстрая запись без перекодирования)
    "output_codec"       : "libx264",         // Кодек финального файла
    "output_preset"      : "fast",            // Пресет ffmpeg
    "output_crf"         : "23",              // Качество H.264 (0-51, меньше = лучше)
    "output_pix_fmt"     : "yuv420p",         // Формат пикселей для совместимости с проигрывателями
    "output_extension"   : "mp4",
    "temp_extension"     : "avi",
    "output_prefix"      : "zed_recording",   // Префикс имени файла (добавляется метка времени)
    "fps_update_interval": 0.5,               // Интервал обновления счётчика FPS в оверлее (сек)
    "rec_queue_size"     : 30                 // Буфер кадров на запись. При переполнении кадры отбрасываются,
                                              //  управление и детекция не тормозят.
  },

  "timing": {
    "vision_thread_join_timeout": 3.0,   // Ожидание завершения потока камеры (сек)
    "thread_stop_timeout"       : 2.0,   // Ожидание завершения потоков детекции/управления/записи (сек)
    "message_clear_timeout"     : 3.0,   // Время показа статусного сообщения перед очисткой (сек)
    "socket_timeout"            : 0.2,   // Таймаут UDP-сокета, чтобы успевать проверять watchdog (сек)
    "arduino_init_delay"        : 2.0,   // Задержка после открытия порта Arduino (сек)
    "arduino_post_stop_delay"   : 0.5,   // Задержка после команды STOP при инициализации (сек)
    "arduino_close_delay"       : 0.1    // Задержка перед закрытием порта (сек)
  }
}