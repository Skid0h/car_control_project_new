#include <Servo.h>

Servo steeringServo;
const int servoPin = 10;

void setup() {
  Serial.begin(9600);
  steeringServo.attach(servoPin);
}

void loop() {
  // Влево
  Serial.println("Left  (1000 us)");
  steeringServo.writeMicroseconds(1000);
  delay(2000);
  
  // Центр
  Serial.println("Center (1500 us)");
  steeringServo.writeMicroseconds(1500);
  delay(2000);
  
  // Вправо
  Serial.println("Right (2000 us)");
  steeringServo.writeMicroseconds(2000);
  delay(2000);
}
