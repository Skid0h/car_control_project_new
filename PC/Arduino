#include <Servo.h>

const int motorPin = 9;        // Пин для ESC (SC-15WP)
const int servoPin = 10;       // Пин для сервопривода HPI SF-10W
Servo motorESC;
Servo steeringServo;

// --- НАСТРОЙКИ FAILSAFE ---
const unsigned long FAILSAFE_TIMEOUT = 500; // 0.5 секунды до аппаратной остановки
unsigned long lastCommandTime = 0;          
bool failsafeActive = false;                

// --- БУФЕР ДЛЯ ЧТЕНИЯ UART ---
const byte numChars = 32;
char receivedChars[numChars];
boolean newData = false;

void setup() {
 Serial.begin(9600);   
 \ 
 
 // Подключаем оборудование
 motorESC.attach(motorPin, 1000, 2000);  
 steeringServo.attach(servoPin);         

 // Обязательная остановка при включении питания
 stopCar();
}

void loop() {
 // 1. Асинхронно читаем порт и ищем пакет формата <MOTOR,STEER>
 recvWithStartEndMarkers();
 
 // 2. Если пакет успешно собран, парсим его
 if (newData == true) {
   parseData();
   newData = false;
 }

 // 3. Аппаратный предохранитель
 if ((millis() - lastCommandTime > FAILSAFE_TIMEOUT) && !failsafeActive) {
   stopCar();
   failsafeActive = true; 
 }
}

// ==========================================
// ФУНКЦИИ ПАРСИНГА И УПРАВЛЕНИЯ
// ==========================================

// Функция неблокирующего чтения. Собирает строку только между '<' и '>'
void recvWithStartEndMarkers() {
 static boolean recvInProgress = false;
 static byte ndx = 0;
 char startMarker = '<';
 char endMarker = '>';
 char rc;

 while (Serial.available() > 0 && newData == false) {
   rc = Serial.read();

   if (recvInProgress == true) {
     if (rc != endMarker) {
       receivedChars[ndx] = rc;
       ndx++;
       if (ndx >= numChars) {
         ndx = numChars - 1; // Защита от переполнения буфера
       }
     } else {
       receivedChars[ndx] = '\0'; // Завершаем строку
       recvInProgress = false;
       ndx = 0;
       newData = true;
     }
   } else if (rc == startMarker) {
     recvInProgress = true;
   }
 }
}

// Быстрый C-парсер строки (разбивает по запятой)
void parseData() {
 char * strtokIndx; // Указатель для функции strtok
 
 // Читаем первое число (Мотор)
 strtokIndx = strtok(receivedChars, ","); 
 if (strtokIndx == NULL) return; // Защита от пустого значения
 int motorValue = atoi(strtokIndx);       

 // Читаем второе число (Руль)
 strtokIndx = strtok(NULL, ","); 
 if (strtokIndx == NULL) return; 
 int steeringValue = atoi(strtokIndx);    

 // Проверка адекватности данных
 if (motorValue >= 1000 && motorValue <= 2000 && steeringValue >= 0 && steeringValue <= 180) {
   lastCommandTime = millis();
   failsafeActive = false;
   motorESC.writeMicroseconds(motorValue);
   steeringServo.write(steeringValue);
 }
}

void stopCar() {
 motorESC.writeMicroseconds(1500);  
 steeringServo.write(90);           
}
