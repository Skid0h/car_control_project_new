<launch>
  <arg name="auto_start" default="true"/>
  <arg name="rviz" default="false"/>
  <param name="use_sim_time" value="false"/>
  <node pkg="car_control_ros" type="controller_node.py" name="car_controller" output="screen" required="true">
    <param name="auto_start" value="$(arg auto_start)"/>
    <rosparam command="load" file="$(find car_control_ros)/config/sim.yaml"/>
  </node>
  <node pkg="car_control_ros" type="simulator_node.py" name="car_simulator" output="screen" required="true"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find car_control_ros)/config/sim.rviz"/>
</launch>
