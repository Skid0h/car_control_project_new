Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/MarkerArray
      Name: Track and car
      Enabled: true
      Marker Topic: /car/sim/markers
    - Class: rviz/Odometry
      Name: Vehicle odometry
      Enabled: true
      Topic: /car/sim/odom
      Keep: 100
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top view
      Scale: 25
      X: 0
      Y: 8
Window Geometry:
  Width: 1000
  Height: 800
