  <version>0.1.0</version>
  <description>Cone controller, lightweight simulator and optional FSDS adapter.</description>
  <maintainer email="salimadze2005-beep@users.noreply.github.com">Project maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
